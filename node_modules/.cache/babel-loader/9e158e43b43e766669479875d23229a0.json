=\"role\" label=\"用户角色\"></el-table-column>\n          <el-table-column prop=\"message\" label=\"角色说明\"></el-table-column>\n          <el-table-column prop=\"code\" label=\"授权码\"></el-table-column>\n          <el-table-column label=\"操作\">\n            <template #default=\"scope\">\n              <el-button size=\"mini\" @click=\"handleEditDialog(scope.row)\">编辑</el-button>\n              <el-button size=\"mini\" type=\"danger\" @click=\"handleDelete(scope.row.id)\">删除</el-button>\n            </template>\n          </el-table-column>\n        </el-table>\n      </el-tab-pane>\n    </el-tabs>\n    \n    <!-- 编辑弹窗 -->\n    <el-dialog :title=\"dialogTitle\" :visible.sync=\"dialogVisible\" width=\"50%\" :before-close=\"handleClose\">\n      <div>\n        <el-form ref=\"userForm\" :model=\"userForm\" label-width=\"80px\">\n          <el-form-item label=\"用户名\">\n            <el-input v-model=\"userForm.username\" disabled></el-input>\n          </el-form-item>\n          <el-form-item label=\"用户角色\">\n            <el-input v-model=\"userForm.role\"></el-input>\n          </el-form-item>\n        </el-form>\n      </div>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"updateUser\">提交</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { mapActions, mapState } from \"vuex\";\n\nexport default {\n  name: \"UserManage\",\n  data() {\n    return {\n      activeName: \"userManage\",\n      dialogTitle: \"编辑用户角色\",\n      dialogVisible: false,\n      userForm: {\n        id: null,\n        username: \"\",\n        role: \"\",\n      },\n    };\n  },\n  computed: {\n    ...mapState(\"user\", [\"users\"]),\n    userList() {\n      return this.users;\n    },\n  },\n  methods: {\n    ...mapActions(\"user\", [\n      \"fetchAllUsers\",\n      \"fetchUserById\",\n      \"createUser\",\n      \"editUser\",\n      \"removeUser\",\n    ]),\n\n    // 初始化用户列表\n    init() {\n      this.fetchAllUsers();\n    },\n\n    // 打开编辑用户角色弹窗\n    handleEditDialog(user) {\n      this.userForm = { ...user }; // 复制用户数据\n      this.dialogVisible = true;\n    },\n\n    // 提交修改表单\n    updateUser() {\n      this.editUser({ id: this.userForm.id, userData: this.userForm })\n        .then(() => {\n          this.$message.success(\"用户信息已更新\");\n          this.dialogVisible = false;\n          this.init(); // 刷新用户列表\n        })\n        .catch(() => {\n          this.$message.error(\"更新失败，请重试\");\n        });\n    },\n\n    // 删除用户\n    handleDelete(userId) {\n      this.$confirm(\"确定删除该用户？\")\n        .then(() => {\n          this.removeUser(userId)\n            .then(() => {\n              this.$message.success(\"用户已删除\");\n              this.init(); // 刷新用户列表\n            })\n            .catch(() => {\n              this.$message.error(\"删除失败，请重试\");\n            });\n        })\n        .catch(() => {\n          this.$message.info(\"取消删除\");\n        });\n    },\n  },\n\n  created() {\n    this.init(); // 在创建时初始化用户列表\n  },\n};\n</script>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAwCA,SAAAA,UAAA,EAAAC,QAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;MACAC,WAAA;MACAC,aAAA;MACAC,QAAA;QACAC,EAAA;QACAC,QAAA;QACAC,IAAA;MACA;IACA;EACA;EACAC,QAAA,EAAAC,aAAA,CAAAA,aAAA,KACAX,QAAA;IACAY,QAAA,WAAAA,SAAA;MACA,YAAAC,KAAA;IACA;EAAA,EACA;EACAC,OAAA,EAAAH,aAAA,CAAAA,aAAA,KACAZ,UAAA,UACA,iBACA,iBACA,cACA,YACA,aACA;IAEA;IACAgB,IAAA,WAAAA,KAAA;MACA,KAAAC,aAAA;IACA;IAEA;IACAC,gBAAA,WAAAA,iBAAAC,IAAA;MACA,KAAAZ,QAAA,GAAAK,aAAA,KAAAO,IAAA;MACA,KAAAb,aAAA;IACA;IAEA;IACAc,UAAA,WAAAA,WAAA;MAAA,IAAAC,KAAA;MACA,KAAAC,QAAA;QAAAd,EAAA,OAAAD,QAAA,CAAAC,EAAA;QAAAe,QAAA,OAAAhB;MAAA,GACAiB,IAAA;QACAH,KAAA,CAAAI,QAAA,CAAAC,OAAA;QACAL,KAAA,CAAAf,aAAA;QACAe,KAAA,CAAAL,IAAA;MACA,GACAW,KAAA;QACAN,KAAA,CAAAI,QAAA,CAAAG,KAAA;MACA;IACA;IAEA;IACAC,YAAA,WAAAA,aAAAC,MAAA;MAAA,IAAAC,MAAA;MACA,KAAAC,QAAA,aACAR,IAAA;QACAO,MAAA,CAAAE,